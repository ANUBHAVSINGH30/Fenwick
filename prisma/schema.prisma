generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// AUTH
// =========================

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(USER)
  emailVerified DateTime?
  image         String?

  events Event[]
  bookings Booking[]

  createdAt DateTime @default(now())
}


// =========================
// CORE DOMAIN
// =========================

model Venue {
  id      String @id @default(cuid())
  name    String
  city    String
  address String

  events Event[]

  createdAt DateTime @default(now())

  @@index([city])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  date        DateTime
  price       Decimal  @db.Decimal(10, 2)

  userId      String
  user        User @relation(fields: [userId], references: [id])

  venueId String
  venue   Venue @relation(fields: [venueId], references: [id])

  seats    Seat[]
  bookings Booking[]

  createdAt DateTime @default(now())

  @@index([category])
  @@index([date])
  @@index([venueId])
  @@index([userId])
}

model Seat {
  id     String @id @default(cuid())
  row    String
  number Int

  status SeatStatus @default(AVAILABLE)

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  booking Booking?

  @@unique([eventId, row, number])
  @@index([eventId, status])
}

// =========================
// BOOKINGS
// =========================

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(PENDING)

  userId String
  user   User @relation(fields: [userId], references: [id])

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  seatId String @unique
  seat   Seat @relation(fields: [seatId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([status])
}

// =========================
// ENUMS
// =========================

enum SeatStatus {
  AVAILABLE
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}